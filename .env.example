APP_NAME=NecuTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=necu_kcal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=259200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
AUTH_REMEMBER_DURATION=259200

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Food search
# Set SCOUT_DRIVER first to build/synchronize the index. Switch
# FOOD_SEARCH_DRIVER only after the first import finishes successfully.
FOOD_SEARCH_DRIVER=database
FOOD_SEARCH_FALLBACK_TO_DATABASE=true
SCOUT_DRIVER=null
SCOUT_QUEUE=true
TYPESENSE_API_KEY=
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_FOODS_COLLECTION=foods
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=1
TYPESENSE_NUM_RETRIES=1
TYPESENSE_MAX_TOTAL_RESULTS=1000
TYPESENSE_FOOD_MAX_CANDIDATES=50
TYPESENSE_MEMORY_LIMIT=2g

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=necutrack
REVERB_APP_KEY=necutrack-local-key
REVERB_APP_SECRET=necutrack-local-secret
REVERB_HOST=localhost
REVERB_PORT=8001
REVERB_SCHEME=http
REVERB_SERVER_PORT=8001
REVERB_ALLOWED_ORIGINS=*

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Open Food Facts
OPEN_FOOD_FACTS_URL=https://static.openfoodfacts.org/data/openfoodfacts-products.jsonl.gz
OPEN_FOOD_FACTS_IMPORT_PATH=storage/app/imports/openfoodfacts-products.jsonl.gz

# AI nutrition estimates
AI_NUTRITION_PROVIDER=gemini
AI_NUTRITION_FULL_DAY_TIMEOUT=120

# Google Gemini (default)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_NUTRITION_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=30

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_NUTRITION_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=30

# USDA FoodData Central generic foods
USDA_FOUNDATION_FOODS_URL=https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_foundation_food_json_2026-04-30.zip
USDA_SR_LEGACY_URL=https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_sr_legacy_food_json_2018-04.zip
USDA_FNDDS_URL=https://fdc.nal.usda.gov/fdc-datasets/FoodData_Central_survey_food_json_2024-10-31.zip

# Other official generic-food sources
CNF_DOWNLOAD_URL=https://open.canada.ca/data/dataset/1b6139bd-ed7e-4043-bc28-ff00e10f3109/resource/019f2a90-e3a9-489d-b6e1-f74f4ba1d006/download/cnf_fcen_all-files-data_2026.zip
FINELI_DOWNLOAD_URL=https://fineli.fi/fineli/content/file/48
COFID_DOWNLOAD_URL=https://assets.publishing.service.gov.uk/media/60538b91e90e07527df82ae4/McCance_Widdowsons_Composition_of_Foods_Integrated_Dataset_2021..xlsx
AFCD_FOODS_DOWNLOAD_URL=https://www.foodstandards.gov.au/sites/default/files/2025-12/AFCD%20Release%203%20-%20Food%20Details.xlsx
AFCD_NUTRIENTS_DOWNLOAD_URL=https://www.foodstandards.gov.au/sites/default/files/2025-12/AFCD%20Release%203%20-%20Nutrient%20profiles.xlsx

# Generic food translations
FOOD_TRANSLATION_PROVIDER=deepl
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
DEEPL_TIMEOUT=60
DEEPL_MAX_REQUEST_BYTES=114688
